{
  "input": {
    "type": "object",
    "properties": {
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 30,
        "description": "How many stories to return."
      }
    },
    "additionalProperties": false
  },
  "output": {
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "url": { "type": ["string", "null"], "description": "Missing for Ask HN and other text posts." },
        "points": { "type": "integer" },
        "author": { "type": "string" },
        "comments": { "type": ["integer", "null"] },
        "posted_at": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "points", "author", "posted_at"]
    }
  }
}
