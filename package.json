{
  "name": "tooldrop",
  "version": "0.0.0",
  "private": true,
  "description": "Turn any website task into a deterministic, self-hosted API and MCP tool.",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "cross-env TURBO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 turbo run typecheck && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:llm": "cross-env TOOLDROP_LLM_TESTS=1 vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:licenses": "node scripts/check-licenses.ts",
    "fixtures": "node scripts/run-fixtures.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:licenses"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
